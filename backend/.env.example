# ==================== PostgreSQL ====================
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=selah
POSTGRES_USER=selah
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ==================== Redis ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# ==================== Django ====================
DJANGO_SETTINGS_MODULE=uivsbe_backend.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
ALLOWED_HOSTS=*
DEBUG=False
CORS_ALLOW_ALL=false
# TOKEN_AES_KEY ≈ 16 bytes; leave empty for a local placeholder
# TOKEN_AES_KEY=

# ==================== AI（optional）====================
# AI_API_BASE=
# AI_API_KEY=
# AI_MODEL=

# ==================== Object storage（optional）====================
# Google Cloud Storage — set your own bucket / service account
GCS_BUCKET=your-gcs-bucket
GCS_PREFIX=uploads/dev
GCS_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Tencent COS fallback（only used when GCS is unset）
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=

# Local bible audio root（optional）
# BIBLE_AUDIO_ROOT=
# Public CDN base for audio（optional）
# BIBLE_AUDIO_CDN_BASE=

# ==================== OAuth ====================
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
# Comma-separated Bundle IDs
# APPLE_OAUTH_CLIENT_IDS=com.example.app
ALLOW_OAUTH_UNVERIFIED=0

# ==================== IAP ====================
APPLE_SHARED_SECRET=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.example.app
GOOGLE_PLAY_PACKAGE=com.example.app
GOOGLE_PLAY_PACKAGE_SELAH=com.example.app
GOOGLE_PLAY_PACKAGE_MANNA=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ALLOW_IAP_SANDBOX=0
ALLOW_IAP_UNVERIFIED=0

# ==================== Google Translate（optional）====================
GOOGLE_TRANSLATE_API_KEY=
